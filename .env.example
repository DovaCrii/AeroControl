# Paths below are examples -- point them at a data directory outside the
# repository (never commit operational data, documents, or secrets).
DEBUG=True
SECRET_KEY=django-insecure-change-me
DB_PATH=C:\AeroControl_Data\db\aero_ops.sqlite3
DOCUMENTS_DIR=C:\AeroControl_Data\documents
BACKUPS_DIR=C:\AeroControl_Data\backups
LOGS_DIR=C:\AeroControl_Data\logs
EXPORTS_DIR=C:\AeroControl_Data\exports
DOCUMENTS_STORAGE_BACKEND=local
# Decides what "today" means: expiry counters, the digest horizon, the alert
# window and the report period all read it. Default: America/Santiago.
# TIME_ZONE=America/Santiago
# DOCUMENTS_STORAGE_BACKEND=s3
# DOCUMENTS_STORAGE_BUCKET=aerocontrol-documents
# DOCUMENTS_STORAGE_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# DOCUMENTS_STORAGE_REGION=us-east-1
# DOCUMENTS_STORAGE_ACCESS_KEY=replace-with-storage-access-key
# DOCUMENTS_STORAGE_SECRET_KEY=replace-with-storage-secret
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60

# Notifications (send_alert_digest). Without EMAIL_HOST the console backend is
# used and mail is printed instead of sent -- fine for dev. Never commit real
# credentials; set these in the environment of the machine that runs the jobs.
#
# LV-119: after setting them, prove it works instead of assuming it does --
# `manage.py check_email` opens the SMTP connection, and `--to you@example.com` sends
# a real message. `manage.py check` passes with the pipe cut, which is how p340
# ran for months printing every notification into the journal.
#
# LV-182: Django 6.1 deprecated the EMAIL_* *settings* in favour of MAILERS, and
# the project migrated. **These variable names did not change**: settings/base.py
# reads them into MAILERS, so an existing /etc/aerocontrol.env keeps working
# untouched -- which is the point, since that file is 600 root and editing it by
# hand is how a credential goes missing.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=aerocontrol@example.com
# EMAIL_HOST_PASSWORD=replace-with-app-password
# STARTTLS on 587 (the default). For implicit SSL on 465 set EMAIL_USE_SSL=True
# instead and leave EMAIL_USE_TLS unset: Django rejects both at once.
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# Must usually equal EMAIL_HOST_USER: a mailbox that authenticates may still be
# refused permission to relay as a different sender.
# DEFAULT_FROM_EMAIL=aerocontrol@example.com
# Base URL used for links inside notification emails
# SITE_BASE_URL=http://aerocontrol.intranet:8000

# Weather forecast on a geo plan's ficha (R8.1, ISO 8.1 meteorological review).
# This is the project's ONLY outgoing HTTP call, so it is off unless you turn it
# on -- leaving it unset keeps the zero-outgoing-calls property. The call is
# made server-side (never from the browser), so the CSP needs no exception.
# LV-353: ON by default. Set WEATHER_ENABLED=False to switch ALL weather off (no card, no
# request, /weather/* answers 404, no outgoing calls). Default city: Santiago
# (WEATHER_DEFAULT_LABEL / _LAT / _LON / _TZ; empty the label to make people pick one).
# WEATHER_ENABLED=False
# LV-365: provider = met_norway (default; NLOD 2.0 / CC BY 4.0, commercial use allowed, no key)
# or open_meteo (paid plan or self-hosted server only: the free API is non-commercial).
# WEATHER_PROVIDER=met_norway
# MET Norway REQUIRES a User-Agent naming the app and a contact. Set it in the environment of the
# server only (never here, never in git). Without it MET is NOT called and the card says"not available".
# WEATHER_USER_AGENT=<app name and contact, set on the server>
# Default depends on the provider (MET: api.met.no locationforecast 2.0 complete).
# WEATHER_API_URL=https://api.met.no/weatherapi/locationforecast/2.0/complete
# Seconds before giving up: a slow provider must not hold a worker.
# WEATHER_TIMEOUT_SECONDS=4
# How long one (place, day) forecast is reused. Also caches failures, so an
# outage does not mean one request per page view.
# WEATHER_CACHE_SECONDS=3600

# LV-342: informative weather card (main page). Open-Meteo's free tier is for NON-COMMERCIAL use,
# so it is only for WEATHER_PROVIDER=open_meteo with a paid plan (WEATHER_API_KEY) or a self-hosted
# WEATHER_API_URL. Never write a real key in this file (environment only).
# WEATHER_API_KEY=
# Only used with WEATHER_PROVIDER=open_meteo.
# WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# LV-366: city search is local first (BCN communes). Nominatim (OpenStreetMap) is optional and OFF:
# 1 request/second, cached, needs WEATHER_USER_AGENT; credit "(c) OpenStreetMap contributors".
# WEATHER_NOMINATIM_ENABLED=False
# WEATHER_PANEL_CACHE_SECONDS=1800
# Demo without Internet (ignored unless DEBUG=True): bundled sample JSON.
# WEATHER_FAKE_FIXTURE=True
# Referential event thresholds (NOT flight conditions; defaults shown).
# WEATHER_EVENT_WIND_KMH=40
# WEATHER_EVENT_GUST_KMH=60
# WEATHER_EVENT_RAIN_MM_24H=20
# WEATHER_EVENT_VISIBILITY_M=1000
# WEATHER_EVENT_HEAT_C=35
# WEATHER_EVENT_FROST_C=0

# LV-352: GNSS scintillation card (informative; makes NO external calls). On by default; turn it
# off with GNSS_SCINTILLATION_ENABLED=False. The 21-03 hours are our reading of "near midnight".
# GNSS_SCINTILLATION_ENABLED=True
# GNSS_SCINT_MONTHS=9,10,11,12,1,2,3,4
# GNSS_SCINT_NIGHT_START=21
# GNSS_SCINT_NIGHT_END=3
# GNSS_SCINT_PEAK_HOUR=0
# GNSS_SCINT_YEARS=2025-2028
# GNSS_SCINT_SOURCE_URL=https://www.geocom.cl/blogs/news/nuevo-portal-de-monitoreo-de-perturbaciones-ionosfericas
# GNSS_SCINT_PORTAL_URL=https://centelleo.geocom.cl

# X.4b / LV-294: AeroLink's battery inventory (`sync_batteries`). Opt-in, like the
# weather call: with no URL nothing is fetched and the command fails loudly instead
# of reporting zero batteries. Both services share the p340 VM, so this is a
# loopback URL and never crosses the public internet. The URL must include the
# version prefix: the client only appends "/devices/?kind=battery".
#
# The token is AeroLink's SERVICE_TOKEN (ADR-0003). Never write its value in this
# file or in chat -- copy it between the two .env files on the VM without printing
# it (see docs/scheduled-operations.md).
# AEROLINK_API_URL=http://127.0.0.1:8081/api/v1
# AEROLINK_API_TOKEN=replace-with-the-service-token
# AEROLINK_TIMEOUT_SECONDS=10

# LV-305: asistente de consulta con IA (PROTOTIPO, solo demo). Apagado por omision y ademas exige DEBUG.
# La llave va SOLO en tu entorno local; nunca la escribas en este archivo ni en el repositorio.
# AI_ASSISTANT_ENABLED=0
# LV-336: en produccion (DEBUG apagado) tambien hace falta esto, y solo con la licencia de NVIDIA resuelta.
# Apagado de emergencia: AI_ASSISTANT_ENABLED=0 y reiniciar. Ver docs/dev/asistente-ia.md.
# AI_ASSISTANT_ALLOW_PRODUCTION=0
# NVIDIA_API_KEY=
# Modelo y cadena de respaldo (lista separada por comas); los valores por omision estan en config/settings/base.py.
# NVIDIA_MODEL=
# NVIDIA_MODEL_FALLBACKS=
# Reintentos ante 429 (max 2) y espera inicial en segundos.
# AI_ASSISTANT_RETRIES_429=2
# AI_ASSISTANT_RETRY_BACKOFF=1.0
# Preguntas por usuario y hora (los creditos de prueba de NVIDIA son limitados); 0 = sin tope.
# AI_ASSISTANT_MAX_PER_HOUR=30

# Report letterhead contact block (printed on the PDF reports for the authority).
# The defaults are generic placeholders: set the real values in the DEPLOYMENT
# environment (never in this public repo), or the reports print the placeholders.
# REPORT_CONTACT_ADDRESS=Calle Ejemplo 123, Ciudad
# REPORT_CONTACT_WEB=www.example.com
# REPORT_CONTACT_PHONE=+56 2 0000 0000
# REPORT_CONTACT_EMAIL=contacto@example.com