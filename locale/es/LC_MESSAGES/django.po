msgstr "Impreso desde AeroControl"

#: templates/reporting/monthly_report.html
msgid "Monthly RPA reportability report to the DGAC."
msgstr "Informe mensual de reportabilidad RPA ante la DGAC."

#: templates/reporting/_leaf.html
msgid "No data at the cutoff: the report does not invent a figure."
msgstr "Sin dato a la fecha de corte: el informe no inventa una cifra."

#: templates/reporting/monthly_report.html
#, python-format
msgid "Frozen report, revision %(revision)s — %(status)s."
msgstr "Informe congelado, revisión %(revision)s — %(status)s."

#: templates/reporting/monthly_report.html
msgid ""
"Live preview: nothing is frozen yet for this period, so these figures move "
"with the database. Freezing and approval come with the generation command."
msgstr ""
"Vista previa en vivo: todavía no hay nada congelado para este período, así "
"que estas cifras se mueven con la base de datos. Congelar y aprobar llegan "
"con el comando de generación."

